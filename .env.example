# ─────────────────────────────────────────────────────────────────────────────
# Omnisc AI — variables d'environnement
#
# Liste EXHAUSTIVE. Toute nouvelle variable est ajoutée ici et dans lib/env.ts
# dans le même commit. Aucune lecture de process.env hors de lib/env.ts.
#
# Copier en `.env.local` pour le développement. En préversion et en production,
# les valeurs sont saisies dans Vercel (Project Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────────────────────

# Base de données Supabase — POOLER EN MODE TRANSACTION, port 6543.
# Supabase Dashboard → Project Settings → Database → Connection string →
# onglet « Transaction pooler ».
# La connexion directe (port 5432) est refusée par le schéma : serverless +
# Postgres direct = épuisement des connexions en production.
# Le pooler en mode transaction ne gère pas les requêtes préparées :
# lib/supabase/server.ts passe `prepare: false`.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# URL du projet Supabase. Utilisée pour l'API Storage (bucket `raw`).
# Supabase Dashboard → Project Settings → API → Project URL.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé `service_role`. NE QUITTE JAMAIS LE SERVEUR.
# Aucun préfixe NEXT_PUBLIC_, aucun import depuis un composant client.
# Supabase Dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Domaine de réception attrape-tout, sans `@`.
# La base ne stocke que `projects.inbound_local_part` ; le domaine doit rester
# modifiable sans migration, le nom du produit n'étant pas arrêté.
INBOUND_DOMAIN=in.omnisc-ai.fr

# Authentification HTTP Basic du webhook Postmark.
# Postmark NE SIGNE PAS ses webhooks — aucune vérification HMAC n'est possible.
# Ce couple est l'unique protection de la route d'ingestion ; il est encodé dans
# l'URL du webhook : https://<user>:<password>@omnisc-ai.fr/api/inbound/postmark
# Le mot de passe doit faire au moins 12 caractères et ne pas contenir de
# caractère nécessitant un encodage dans une URL (`@`, `:`, `/`, `#`, `?`).
POSTMARK_WEBHOOK_USER=postmark
POSTMARK_WEBHOOK_PASSWORD=changez-moi-32-caracteres-aleatoires

# ─────────────────────────────────────────────────────────────────────────────
# Injectées automatiquement par Vercel — ne pas saisir à la main.
# Optionnelles dans le schéma : absentes en local.
# ─────────────────────────────────────────────────────────────────────────────
# SHA du commit déployé, renvoyé par /api/health.
# VERCEL_GIT_COMMIT_SHA=
# 'production' | 'preview' | 'development'
# VERCEL_ENV=
# Posé par Next.js ('development' | 'test' | 'production'). Présent dans le
# schéma pour que rien ne lise process.env hors de lib/env.ts.
# NODE_ENV=
